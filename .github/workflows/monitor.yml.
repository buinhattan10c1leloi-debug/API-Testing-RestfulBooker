name: Production Health Check Monitor

on:
  schedule:
    - cron: '0 * * * *' # Cứ mỗi 1 giờ máy chủ sẽ tự động chạy kiểm tra một lần
  workflow_dispatch: # Cho phép bạn bấm nút chạy thủ công bất cứ lúc nào

jobs:
  monitor:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '18'

      - name: Install Postman CLI
        run: npm install -g postman-cli

      - name: Login to Postman CLI
        run: postman login --with-api-key ${{ secrets.POSTMAN_API_KEY }}

      - name: Run Monitor / Collection
        run: postman collection run Production_Monitor_Demo
